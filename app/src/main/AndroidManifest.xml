<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Android 11+ (API 30) hides other apps' packages by default (package visibility).
        Declare the calculator lookup intent plus known OEM calculator packages so
        PackageManager can resolve/launch them from CalculatorTileService.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALCULATOR" />
        </intent>
        <package android:name="com.google.android.calculator" />
        <package android:name="com.android.calculator2" />
        <package android:name="com.sec.android.app.popupcalculator" />
        <package android:name="com.miui.calculator" />
        <package android:name="com.oneplus.calculator" />
        <package android:name="com.coloros.calculator" />
        <package android:name="com.huawei.calculator" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Custom Quick Settings tile: shows a calculator icon and opens the device's calculator app -->
        <service
            android:name=".CalculatorTileService"
            android:exported="true"
            android:icon="@drawable/ic_calculator"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Passive tile: state only changes in response to user taps, not background events -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
    </application>
</manifest>
